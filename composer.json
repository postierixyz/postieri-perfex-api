{
    "name": "postierixyz/postieri-perfex-api",
    "description": "REST API + webhooks module for Perfex CRM (3.2+), by Postieri XYZ",
    "type": "perfex-module",
    "license": "MIT",
    "keywords": [
        "perfex",
        "perfexcrm",
        "crm",
        "api",
        "rest",
        "webhooks",
        "codeigniter",
        "hmvc"
    ],
    "homepage": "https://postieri.xyz",
    "support": {
        "issues": "https://github.com/postierixyz/postieri-perfex-api/issues",
        "source": "https://github.com/postierixyz/postieri-perfex-api"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Perfexcrm\\Postieri\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Perfexcrm\\Postieri\\Api\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src controllers libraries models --level=5",
        "cs-check": "phpcs --standard=PSR12 src controllers libraries models",
        "cs-fix": "phpcbf --standard=PSR12 src controllers libraries models"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
